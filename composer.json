{
  "name": "tracyapps/in-synced",
  "description": "Authenticated WordPress site synchronization.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": { "php": ">=7.2" },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "wp-coding-standards/wpcs": "^3.0",
    "yoast/phpunit-polyfills": "^2.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "config": {
    "platform": { "php": "8.1" },
    "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit -c phpunit-unit.xml.dist",
    "test:integration": "phpunit -c phpunit.xml.dist",
    "lint": "phpcs",
    "lint-fix": "phpcbf"
  }
}
